# Copy to .env for local development. Never commit .env.
# Values below are local-development defaults only.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=opsforge
POSTGRES_PASSWORD=opsforge
POSTGRES_DB=opsforge

# --- API ---
API_ENV=development
API_LOG_LEVEL=info
API_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://opsforge:opsforge@localhost:5432/opsforge
REDIS_URL=redis://localhost:6379/0

# --- Accounts (optional; defaults shown) ---
# AUTH_ALLOW_REGISTRATION=true   # set false to close sign-up
# AUTH_SESSION_TTL_HOURS=336     # 14 days
# AUTH_COOKIE_SECURE=            # empty: on in production, off elsewhere
# AUTH_LOGIN_MAX_FAILURES=5      # failed logins per email before a lockout
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_LOCKOUT_SECONDS=900
# AUTH_REGISTER_MAX_PER_HOUR=10  # per client address

# --- Request limits and proxies (optional; see docs/SECURITY.md) ---
# API_MAX_BODY_BYTES=2097152     # larger bodies get 413
# API_TRUSTED_PROXIES=0          # reverse proxies appending to X-Forwarded-For; 0 ignores it

# --- Web (Vite dev server proxies /api to this target) ---
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Host port overrides (change if another project already uses these) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# WEB_PORT=8080
# OPSFORGE_TAG=dev   # tag for locally built opsforge-* images
