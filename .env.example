# Copy to .env for local development. Never commit .env.
# Values below are local-development defaults only.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=opsforge
POSTGRES_PASSWORD=opsforge
POSTGRES_DB=opsforge

# --- API ---
API_ENV=development
API_LOG_LEVEL=info
API_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://opsforge:opsforge@localhost:5432/opsforge
REDIS_URL=redis://localhost:6379/0

# --- Web (Vite dev server proxies /api to this target) ---
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Host port overrides (change if another project already uses these) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# WEB_PORT=8080
# OPSFORGE_TAG=dev   # tag for locally built opsforge-* images
